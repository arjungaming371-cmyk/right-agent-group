# ============================================================
# Right Agent Group FINAL_10.1 (Cloud API) — Environment Configuration
# Copy this file to .env and fill in every value marked ❌
# ⭕ = fill when going live with calls
# ============================================================

# --- App URL (no trailing slash, must be https for OAuth + Meta webhook) ---
NEXT_PUBLIC_APP_URL=https://your-domain.com          # ❌ your named-tunnel domain
# No domain yet? scripts/tunnel-autofix.ps1 uses ngrok's one free reserved
# static domain instead (stable across restarts, unlike a random quick
# tunnel) — set it up once at dashboard.ngrok.com and put it here:
NGROK_DOMAIN=                                        # e.g. your-name.ngrok-free.dev

# --- PostgreSQL ---
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=right_agent_group
PG_USER=postgres
PG_PASSWORD=                                         # ❌

# --- Priya's brain (Groq OR Sarvam) ---
# LLM_PROVIDER=groq    (default) Groq Cloud API — free tier, fastest tokens.
# LLM_PROVIDER=sarvam            Sarvam-105B via api.sarvam.ai/v1 — OpenAI-
#                                compatible, post-trained conversational variant
#                                for voice agents, native Indic + code-mixed text.
# Whichever provider you choose, its API key is REQUIRED — without it, calls,
# WhatsApp replies, and every AI feature will fail.
LLM_PROVIDER=groq                                     # groq | sarvam
GROQ_API_KEY=                                         # ⭕ gsk_... (required when LLM_PROVIDER=groq; free: console.groq.com — enable Zero Data Retention)
# GROQ_MODEL=openai/gpt-oss-120b                      # default
# GROQ_UTILITY_MODEL=openai/gpt-oss-20b               # default (smaller, for JSON tasks)
SARVAM_API_KEY=                                       # ⭕ (required when LLM_PROVIDER=sarvam or cloud STT/TTS; get one at dashboard.sarvam.ai)
# SARVAM_LLM_MODEL=sarvam-105b-conversations          # default — conversational variant, built for voice agents
# SARVAM_LLM_UTILITY_MODEL=sarvam-105b-conversations  # default: same model for JSON tasks
# SARVAM_REASONING_EFFORT=                            # EMPTY (default) = thinking OFF — correct for live calls.
#                                                     # low|medium|high re-enables it (slower, more expensive)

# --- Google Login (console.cloud.google.com/apis/credentials) ---
# Redirect URI must be exactly: https://your-domain.com/api/auth/google/callback
GOOGLE_CLIENT_ID=                                    # ❌
GOOGLE_CLIENT_SECRET=                                # ❌
AUTH_SECRET=                                         # ❌ generate: openssl rand -hex 32 (min 32 chars)
ADMIN_EMAIL=your-email@gmail.com                     # ❌ always has dashboard access

# --- Exotel (phone calls) ---
EXOTEL_SID=                                          # ⭕
EXOTEL_API_KEY=                                      # ⭕
EXOTEL_API_TOKEN=                                    # ⭕
EXOTEL_SUBDOMAIN=api.exotel.com
EXOTEL_CALLER_ID=                                    # ⭕ your ExoPhone number
EXOTEL_FLOW_APP_ID=                                  # ⭕ from App Bazaar Voicebot flow

# --- Webhook & WebSocket secrets (REQUIRED since the 2026-09 security pass) ---
# The app FAILS CLOSED without these: Exotel webhooks and the /voicebot
# WebSocket reject unauthenticated requests instead of trusting anyone who
# finds the URL. Generate each with: openssl rand -hex 32
EXOTEL_WEBHOOK_KEY=                                  # ❌ REQUIRED — also paste into the Exotel dashboard:
#                                                        Status callback URL: https://your-domain.com/api/calls/status?key=THIS_VALUE
#                                                        Passthru applet URL: https://your-domain.com/api/calls/passthru?key=THIS_VALUE
VOICEBOT_WS_KEY=                                     # ❌ REQUIRED — Exotel Voicebot applet URL becomes:
#                                                        wss://your-domain.com/voicebot?key=THIS_VALUE
ALLOW_UNSIGNED_WEBHOOK=                              # ⚠ DEV ONLY — "1" accepts unsigned webhooks (local testing
#                                                        without Meta/Exotel). NEVER set this on the public deployment.

# --- WhatsApp Business Cloud API (SETUP-GUIDE-CLOUD-API.md steps 3,5,6) ---
WHATSAPP_TOKEN=                                      # ❌ permanent System User token (EAA...)
WHATSAPP_PHONE_NUMBER_ID=                            # ❌ Phone Number ID (NOT the phone number)
WHATSAPP_VERIFY_TOKEN=rag-verify-2026                # ❌ any string — must match Meta webhook setup
WHATSAPP_APP_SECRET=                                 # ❌ REQUIRED — webhook signature verification.
#                                                        Without it /api/whatsapp accepts fake payloads
#                                                        from anyone (junk leads, wasted AI, spam sends).
WHATSAPP_FORM_TEMPLATE=loan_application_form
# Auto-sent once per call (create + get these approved in WhatsApp Manager too):
WHATSAPP_CALL_FOLLOWUP_TEMPLATE=call_followup           # sent after any completed call with real conversation
WHATSAPP_MISSED_CALL_TEMPLATE=missed_call_followup      # sent when a call is missed/busy/no-answer

# --- Internal service auth (one shared secret: app ↔ voicebot ↔ STT) ---
# Required even on the all-cloud setup: the voicebot authenticates to the
# Next.js app with it, and the local STT/TTS services use it when enabled.
# Generate ONCE: openssl rand -hex 32 — paste the SAME value in BOTH lines:
WHATSAPP_SERVICE_KEY=                                # ❌
STT_API_KEY=                                         # ❌ SAME value as WHATSAPP_SERVICE_KEY
# (START.ps1 auto-copies it, but pm2/manual STT startup reads this line)

# --- Voice pipeline providers (the big AWS cost lever) ---
# The local demo stack runs self-hosted Whisper (STT) + Edge TTS — free but
# needs Python services, a GPU/model download for Whisper, and setup time.
# For AWS, switch BOTH to cloud APIs and SKIP the Python services entirely
# (START.ps1 detects this automatically). Exotel telephony is unchanged.
#
#   STT_PROVIDER=local    (default) self-hosted Whisper (server/stt-service)
#   STT_PROVIDER=sarvam             Sarvam Saaras cloud STT — 8kHz telephony
#                                   audio accepted natively, mode=translit
#                                   returns Roman Tenglish/Hinglish directly
#                                   (same contract the Whisper pipeline had)
STT_PROVIDER=local                                    # local | sarvam
STT_SERVICE_URL=http://127.0.0.1:3003                 # only used by STT_PROVIDER=local
# STT_FORCE_DEVICE=cpu                                # local only: "cuda" with an NVIDIA GPU
# STT_MODEL=small                                     # local only: small on CPU, large-v3 on GPU
# STT_VAD_FILTER=0                                    # keep OFF: the voicebot already endpoints
#
#   TTS_CALL_PROVIDER=edge      (default) self-hosted Edge TTS (server/tts-service)
#   TTS_CALL_PROVIDER=sarvam              Sarvam Bulbul v3 — Indian voices, code-mixed
#                                         text (Telugu/Devanagari + English loanwords)
#                                         handled natively. Female speaker "priya".
#   TTS_CALL_PROVIDER=cartesia            Cartesia Sonic — 40+ languages incl.
#                                         en-IN/hi-IN/te-IN, very high quality.
# All three flow through the SAME ffmpeg telephony chain (band-pass +
# compressor + limiter → 8kHz PCM) — caller-heard loudness is identical.
TTS_CALL_PROVIDER=edge                                # edge | sarvam | cartesia
TTS_SERVICE_URL=http://127.0.0.1:3004                 # only used by TTS_CALL_PROVIDER=edge
#
# --- Sarvam (STT + TTS + LLM all share ONE key) ---
# SARVAM_STT_MODEL=saaras:v4                          # default; check docs.sarvam.ai for the current version tag
# SARVAM_STT_MODE=translit                            # translit (default) = Roman Tenglish/Hinglish.
#                                                     # transcribe = native script; codemix = mixed
# SARVAM_STT_AUTO=0                                   # 1 = always auto-detect language instead of
#                                                     # passing the call's known language
# SARVAM_TTS_MODEL=bulbul:v3                          # default
# SARVAM_TTS_SPEAKER=priya                            # default — female, on-brand. Others: ritu, neha,
#                                                     # pooja, simran, kavya, shreya, roopa, tanya,
#                                                     # shruti, kavitha, rupali; males: shubh, aditya, rahul...
# SARVAM_TTS_SAMPLE_RATE=24000                        # 8000-48000 (24k default is best for the ffmpeg chain)
# SARVAM_TTS_PACE=1.0                                 # 0.5-2.0 speaking pace (1.0 = normal)
#
# --- Cartesia (TTS alternative — requires its own key + a voice ID) ---
CARTESIA_API_KEY=                                     # ⭕ only when TTS_CALL_PROVIDER=cartesia (play.cartesia.ai/keys)
CARTESIA_VOICE_ID=                                    # ⭕ only when TTS_CALL_PROVIDER=cartesia — pick a voice at
#                                                     #    https://play.cartesia.ai/voices and copy its ID
# CARTESIA_MODEL=sonic-3.6                            # default
# CARTESIA_SAMPLE_RATE=24000                          # 8000-48000
# CARTESIA_SPEED=1.0                                  # 0.6-1.5 (1.0 = normal)

# Dashboard "speak" button (lib/tts.ts) — separate from the phone pipeline.
# edge (default) | sarvam | cartesia | elevenlabs — Sarvam/Cartesia share the
# keys above, so the dashboard can use the SAME voice as the phone calls.
# TTS_PROVIDER=edge
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# --- Voicebot ---
VOICEBOT_PORT=3002
APP_INTERNAL_URL=http://127.0.0.1:3000
# VOICEBOT_ENERGY_THRESHOLD=300                      # avg abs amplitude (0..32767) that counts
#                                                      as speech; lower if quiet callers are missed
# VOICEBOT_DEBUG_DIR=C:\debug-audio                  # if set, dumps each caller utterance as .wav
# VOICEBOT_TTS_VOLUME=2.0                            # playback gain (1 = off); peaks are limited
#                                                      so boosting can't clip into distortion
# VOICEBOT_AUDIO_FILTER=1                            # 1 = band-pass + compress for the phone line
#                                                      (~2dB louder, evens out level swings).
#                                                      0 = old plain-gain behaviour
#
# Barge-in — letting the caller interrupt Priya mid-sentence. OFF by default:
# whether it works depends on how much of Priya's own audio Exotel echoes back
# into the inbound stream, which nothing in the code can tell you. If the line
# echoes she hears herself, decides the caller is talking, and cuts herself off
# on every sentence. MEASURE FIRST with the echo probe below.
# VOICEBOT_ECHO_PROBE=0                              # 1 = measure echo during ONE ordinary call
#                                                      (barge-in stays off; stay silent through a
#                                                      full reply, then read the call summary)
# VOICEBOT_BARGE_IN=0                                # 1 = enable interruption. Only after the
#                                                      probe reports SAFE
# VOICEBOT_BARGE_ENERGY=600                          # sustained energy that counts as the caller
#                                                      cutting in (default: 2x ENERGY_THRESHOLD)
# VOICEBOT_BARGE_MIN_MS=300                          # how long that energy must last — guards
#                                                      against coughs and codec artefacts
# VOICEBOT_PLAYBACK_LEAD_MS=300                      # audio buffered ahead of real time; also the
#                                                      worst-case overhang after an interrupt

# --- Cloudflare NAMED tunnel (stable URL — required in production) ---
# Quick tunnels change URL every restart, breaking Google login, the Meta
# webhook, Exotel callbacks AND the voicebot WebSocket (which needs an
# ingress rule to port 3002 — see cloudflared-config.example.yml).
# Setup: cloudflared tunnel create rag
#        cloudflared tunnel route dns rag your-domain.com
CF_TUNNEL_NAME=rag                                   # ❌ set to your tunnel name

# --- Email confirmations (OPTIONAL — skipped if blank) ---
# Gmail: create an App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Right Agent Group <yourbusiness@gmail.com>"

# --- IP allowlist (Access Controls → IP Allowlist toggle) ---
# Comma-separated. Exact IPs, or prefixes ending in "." for a whole range.
# Only enforced while the dashboard toggle is ON; empty list = fail-open.
# IP_ALLOWLIST=203.0.113.7,49.207.

# --- Optional overrides ---
# APPLICATION_FORM_URL=                              # only if the form lives elsewhere
